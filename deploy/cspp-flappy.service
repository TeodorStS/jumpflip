# systemd unit for CS++ Flappy
#
# Install on the VPS:
#   sudo cp deploy/cspp-flappy.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cspp-flappy
#
# Check it:
#   systemctl status cspp-flappy
#   journalctl -u cspp-flappy -f
#
# Adjust User and WorkingDirectory to match where you cloned the repo.

[Unit]
Description=CS++ Flappy (TU Dublin society game + leaderboard)
Documentation=https://github.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Run as an unprivileged user, never root. Create one with:
#   sudo adduser --system --group --home /srv/cspp-flappy cspp
User=cspp
Group=cspp

WorkingDirectory=/srv/cspp-flappy
ExecStart=/usr/bin/node server.js

Environment=NODE_ENV=production
Environment=PORT=3000
# Keep the database outside the code directory so a redeploy (git pull,
# or even a fresh clone) can never wipe the scores.
Environment=DB_DIR=/var/lib/cspp-flappy

# Restart on crash, but back off so a genuinely broken build does not spin.
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5

# --- Hardening -------------------------------------------------------
# The app only needs to read its own code and write its database.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cspp-flappy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Logs go to the journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cspp-flappy

[Install]
WantedBy=multi-user.target
